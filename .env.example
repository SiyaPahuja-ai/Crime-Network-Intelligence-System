# Crime Network Intelligence System (CNIS) - Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env containing sensitive information)

# Backend Server Configuration
CNIS_API_HOST=127.0.0.1
CNIS_API_PORT=8000

# Frontend Development Server Configuration
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Environment Mode (development / staging / production)
ENVIRONMENT=development

